# LLM API keys — fill in the keys for the models you want to use (at least one required).
# Models without a key will be disabled in the UI.
ANTHROPIC_API_KEY=        # Claude Haiku 4.5
GEMINI_API_KEY=           # Gemini 2.5 Flash, Gemini 3 Flash
OPENAI_API_KEY=           # GPT-5.4 mini

# Optional (defaults shown). Leave commented unless you need to override.
# MAX_PDF_SIZE_MB=100
# MAX_PDF_PAGES=100
# RESULT_TTL_SECONDS=3600
# RENDER_DPI=150
# CORS_ORIGINS=http://localhost:9017
#
# DATA_DIR controls where uploaded PDFs and generated outputs live.
# Default (omitted): <project_root>/data — works on Windows and *nix.
# Relative paths are resolved against the project root, not the CWD.
# Examples:
#   DATA_DIR=./data        # = <project_root>/data
#   DATA_DIR=d:/work/data  # absolute path

# Ports (project-specific: backend=9007, frontend=9017)
BACKEND_PORT=9007
FRONTEND_PORT=9017

# Frontend
NEXT_PUBLIC_API_BASE=http://localhost:9007
